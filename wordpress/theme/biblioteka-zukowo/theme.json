{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"custom": false,
			"customDuotone": false,
			"customGradient": false,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "slug": "black", "name": "Granat (tekst)", "color": "#000021" },
				{ "slug": "blue", "name": "Niebieski", "color": "#015D96" },
				{ "slug": "red", "name": "Czerwony", "color": "#E22C3F" },
				{ "slug": "white", "name": "Biały", "color": "#FFFFFF" },
				{ "slug": "gray-light", "name": "Jasnoszary", "color": "#F5F5F5" },
				{ "slug": "gray", "name": "Szary (stopka)", "color": "#EBEBEA" }
			]
		},
		"layout": {
			"contentSize": "768px",
			"wideSize": "1280px"
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.25rem" },
				{ "slug": "50", "name": "L", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2rem, 6vw, 3.125rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(3rem, 8vw, 5rem)" }
			]
		},
		"typography": {
			"customFontSize": false,
			"defaultFontSizes": false,
			"dropCap": false,
			"fontFamilies": [
				{
					"slug": "montserrat",
					"name": "Montserrat",
					"fontFamily": "Montserrat, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/montserrat-latin-ext-wght-normal.woff2"],
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF"
						},
						{
							"fontFamily": "Montserrat",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": ["file:./assets/fonts/montserrat-latin-wght-normal.woff2"],
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Mały", "size": "0.8125rem" },
				{ "slug": "medium", "name": "Normalny", "size": "1rem" },
				{ "slug": "large", "name": "Duży", "size": "1.125rem" },
				{ "slug": "x-large", "name": "Bardzo duży", "size": "1.375rem" },
				{ "slug": "xx-large", "name": "Nagłówek", "size": "clamp(1.75rem, 1.2rem + 2vw, 2.25rem)" },
				{ "slug": "huge", "name": "Tytuł", "size": "clamp(2rem, 1.4rem + 2.4vw, 2.75rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--black)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "20px",
				"right": "20px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--montserrat)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--blue)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "typography": { "textDecoration": "none" } },
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--blue)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--black)" },
				"typography": { "fontWeight": "900", "lineHeight": "1.2" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "1.25rem" } },
			"h5": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"h6": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--blue)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": { "radius": "6px" },
				"spacing": { "padding": { "top": "1rem", "bottom": "1rem", "left": "1.75rem", "right": "1.75rem" } },
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600", "textDecoration": "none" },
				":hover": { "color": { "background": "var(--wp--preset--color--black)" } },
				":focus-visible": {
					"outline": {
						"color": "var(--wp--preset--color--black)",
						"offset": "2px",
						"style": "solid",
						"width": "2px"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var(--wp--preset--font-size--large)", "fontWeight": "600" }
			},
			"core/post-date": {
				"color": { "text": "var(--wp--preset--color--black)" },
				"typography": { "fontSize": "var(--wp--preset--font-size--small)", "fontWeight": "600" }
			},
			"core/table": {
				"border": { "width": "0" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Nagłówek", "area": "header" },
		{ "name": "footer", "title": "Stopka", "area": "footer" },
		{ "name": "today-bar", "title": "Pasek: dziś jesteśmy otwarci", "area": "uncategorized" }
	]
}
